
# Create splits
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down

# Navigate splits
keybind = super+alt+h=goto_split:left
keybind = super+alt+l=goto_split:right
keybind = super+alt+k=goto_split:up
keybind = super+alt+j=goto_split:down

# Resize splits
keybind = super+ctrl+shift+h=resize_split:left,20
keybind = super+ctrl+shift+l=resize_split:right,20
keybind = super+ctrl+shift+k=resize_split:up,20
keybind = super+ctrl+shift+j=resize_split:down,20

# Zoom / hide other splits
keybind = super+shift+enter=toggle_split_zoom

# Equalize all split sizes
keybind = super+ctrl+equal=equalize_splits

# Keys for Neovim that Ghostty would otherwise keep or turn into text. Each sends the kitty
# keyboard encoding of the key (CSI <codepoint>;<1 + shift 1, alt 2, ctrl 4, super 8>u), which
# Neovim reads as the real <D-…>/<M-…> key. Made-up codes like csi:99~ are dropped by Neovim 0.12.
keybind = super+l=csi:108;9u
keybind = super+shift+c=csi:99;10u
keybind = super+slash=csi:47;9u
keybind = super+z=csi:122;9u
keybind = super+shift+z=csi:122;10u
keybind = super+s=csi:115;9u
keybind = super+r=csi:114;9u
keybind = super+shift+e=csi:101;10u
keybind = alt+shift+f=csi:102;4u
keybind = alt+j=csi:106;3u
keybind = alt+k=csi:107;3u
# Cmd+C copies Ghostty's own selection when there is one (the shell, Shift+drag); otherwise the
# key goes to the app, where Neovim gets <D-c> and copies its visual selection.
keybind = performable:super+c=copy_to_clipboard

# gtab managed include
config-file = ?"/Users/nasirjd/.config/gtab/ghostty-shortcut.conf"

# Option+Backspace deletes the previous word everywhere (shell, Neovim insert/command line, pickers):
# sent as Ctrl+W directly, so it never arrives as a split <Esc> + <BS> that closes pickers
keybind = alt+backspace=text:\x17

# Persian / Arabic: Geeza Pro has every letter form (the default fallback draws blobs for the presentation forms)
font-codepoint-map = U+0600-U+06FF=Geeza Pro
font-codepoint-map = U+FB50-U+FDFF=Geeza Pro
font-codepoint-map = U+FE70-U+FEFF=Geeza Pro
