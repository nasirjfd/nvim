#!/bin/sh
# Never push a failing configuration: the whole suite runs (in parallel, about a minute) before every push.
# Enabled once per clone with:  git config core.hooksPath .githooks
# Skip only in an emergency:     git push --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push: running tests/run.sh ..."
if ! tests/run.sh > /tmp/nvim-config-pre-push.log 2>&1; then
  sed -n '/^Failures:/,$p' /tmp/nvim-config-pre-push.log
  echo "pre-push: tests failed, push refused (full log: /tmp/nvim-config-pre-push.log)"
  exit 1
fi
tail -1 /tmp/nvim-config-pre-push.log
